N/* ------------------------------------------------------------------------*/
N/* Function Prototypes                                                     */
N/* ------------------------------------------------------------------------*/
N
Nextern short int IIR_filter_fxpt (short int x);
Nextern short int IIR_filter_fxpt_opt1 (short int x);
Nextern short int IIR_filter_fxpt_opt2 (short int x);
N
Nextern float     IIR_filter_flpt (float x) ;
N
N
Nshort int tab_out_fxpt_ref[Npts];
Xshort int tab_out_fxpt_ref[1024];
Nshort int tab_out_fxpt_test[Npts];
Xshort int tab_out_fxpt_test[1024];
Nfloat     tab_out_flpt[Npts];
Xfloat     tab_out_flpt[1024];
N
N
Nint main()
N{
N    short int n;
N    
N    
N    for(n=0; n< Npts; n++)
X    for(n=0; n< 1024; n++)
N    {
N        
N        /* L'entree est en format virgule fixe cadree a gauche */
N        
N        tab_out_fxpt_ref[n]  = IIR_filter_fxpt_opt1 (tab_in_fxpt[n]) ;
N        tab_out_fxpt_test[n] = IIR_filter_fxpt_opt2 (tab_in_fxpt[n]) ;
N        tab_out_flpt[n]      = IIR_filter_flpt (tab_in_flpt[n]) ;
N    }
N    
N   
N    
N}
