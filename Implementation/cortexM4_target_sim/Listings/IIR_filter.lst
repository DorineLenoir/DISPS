N#define     N_cell       4
N#define     N_filter     3
N
N/* ------------------------------------------------------------------------*/ 
N/* Global variables                                      				   */
N/* ------------------------------------------------------------------------*/ 
N
Nfloat       w_flpt[N_cell][N_filter];
Xfloat       w_flpt[4][3];
Nshort int   w_fxpt[N_cell][N_filter];
Xshort int   w_fxpt[4][3];
Nshort int   w_fxpt_dbl[N_cell][2*N_filter];
Xshort int   w_fxpt_dbl[4][2*3];
