N/* ------------------------------------------------------------------------*/
N/* IIR 8 filter in floating-point                                          */
N/* ------------------------------------------------------------------------*/
N
Nfloat  IIR_filter_flpt(float x)
N{
Nfloat acc1, acc2;
Nfloat y;
Nshort int k;
N    
N    /* Input scaling : */
N    
N    acc1 = x ;      /* Q1 => (32,6,25) : Dec = 16 + (1-6)*/
N    
N    for(k=0;k<N_cell;k++)
X    for(k=0;k<4;k++)
N    {
N        /* Computation on double precision (32 bits) : Q5.11 * Q2.14 => Q7.25       */
N        
N        acc1 += a_flpt[k][1] * w_flpt[k][1]+
N                a_flpt[k][2] * w_flpt[k][2];
N        
N        /* Storage in simple precision on (16 bits) Q5.11  */
N        
N        w_flpt[k][0] = acc1;
N        
N        /* suite du calcul en Q26 sur 32 bits (16,4,11)*(16,0,15)=(32,5,26)*/
N        
N        acc2 =  b_flpt[k][0] * w_flpt[k][0]+
N                b_flpt[k][1] * w_flpt[k][1]+
N                b_flpt[k][2] * w_flpt[k][2];
N        
N        /* Filter cascading */
N        
N        acc1 = acc2;
N        
N        /* Data delay */
N        
N        w_flpt[k][2] = w_flpt[k][1];
N        w_flpt[k][1] = w_flpt[k][0];
N        
N    }
N    
N    y = acc2;
N    
N    return y;
N
N}
N
N/* ------------------------------------------------------------------------*/
N/* IIR 8 filter in fixed-point                                          */
N/* ------------------------------------------------------------------------*/
N
Nshort int IIR_filter_fxpt_opt1(short int x)
N{
Nlong  int acc1_32, acc2_32;
Nshort int w, w1, w2, y;
Nshort int k;
Nstatic long int * ptr_W ;
Nstatic long int * ptr_C ;
N        
N    /* Input scaling : */
N    
N    acc1_32 = ((long int)(x)) << 10 ;      /* Q1.15 => Q7.25 : Dec = 16 + (1-6) */
N    
N    for(k=0;k<N_cell;k++)
X    for(k=0;k<4;k++)
N    {
N        ptr_W = ( long int *)(& w_fxpt[k][1]);
N        ptr_C = ( long int *)(& c_fxpt[k][0]);
N        
N        /* Computation on double precision (32 bits) : Q5.11 * Q2.14 => Q7.25       */
N        
N        acc1_32 = __SMLAD(*ptr_W, *ptr_C++, acc1_32);
X        acc1_32 = __smlad(*ptr_W, *ptr_C++, acc1_32);
N       
N        /* Storage in simple precision on (16 bits) Q7.25 => Q5.11  */
N        
N        w =(short int)(acc1_32 >> 14);
N        
N        /* Computation on double precision (32 bits) : Q5.11 * Q1.15 => Q6.26  */
N        
N        acc2_32 =   (long int)(b_fxpt[k][0] * w); 
N        
N        acc2_32 = __SMLAD(*ptr_W, *ptr_C, acc2_32);
X        acc2_32 = __smlad(*ptr_W, *ptr_C, acc2_32);
N        
N        /* Filter cascading : Q6.26 => Q7.25 */
N        
N        acc1_32 = acc2_32 >> 1;
N        
N        /* Data  */
N        
N        w_fxpt[k][2] = w1;
N        w_fxpt[k][1] = w;
N
N
N    }
N    /* Filter output : Q6.26 => Q2.14 */
N    
N    y = (short int)( acc2_32 >> 12);
N    
N    return y;
