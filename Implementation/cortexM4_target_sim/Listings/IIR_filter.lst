N/* ------------------------------------------------------------------------*/
N/* IIR 8 filter in fixed-point                                          */
N/* ------------------------------------------------------------------------*/
N
Nshort int IIR_filter_fxpt_opt2(short int x)
N{
N    long  int acc1_32, acc2_32;
N    short int y;
N    short int k;
N    short int w, w1, w2;
N    static int idx = 0;
N
N    
N    /* Input scaling : */
N    
N    acc1_32 = ((long int)(x)) << 10 ;      /* Q1.15 => Q7.25 : Dec = 16 + (1-6) */
N    
N	 
N    for(k=0;k<N_cell;k++)
X    for(k=0;k<4;k++)
N    {
N        w1 = w_fxpt_dbl[k][idx+N_filter-1];
X        w1 = w_fxpt_dbl[k][idx+3-1];
N        w2 = w_fxpt_dbl[k][idx+N_filter-2];
X        w2 = w_fxpt_dbl[k][idx+3-2];
N                
N
N        /* Computation on double precision (32 bits) : Q5.11 * Q2.14 => Q7.25       */
N        
N        acc1_32 +=  (long int)(c_fxpt[k][0] * w1)+
N                    (long int)(c_fxpt[k][1] * w2);
N        
N        /* Storage in simple precision on (16 bits) Q7.25 => Q5.11  */
N        
N        w = (short int)(acc1_32 >> 14);
N        
N        /* Computation on double precision (32 bits) : Q5.11 * Q1.15 => Q6.26  */
N        
N        acc2_32 =   (long int)(c_fxpt[k][2] * w) +
N                    (long int)(c_fxpt[k][3] * w1) +
N                    (long int)(c_fxpt[k][4] * w2);
N        
N        /* Filter cascading : Q6.26 => Q7.25 */
N        
N        acc1_32 = acc2_32 >> 1;
N        
N        /* Data  */
N        
N        
N        w_fxpt_dbl[k][idx] = w;
N        w_fxpt_dbl[k][idx + N_filter] = w;
X        w_fxpt_dbl[k][idx + 3] = w;
N        
N
N    }
N    idx ++;
N    
N    if(idx>=3) idx =0;
N    
N    /* Filter output : Q6.26 => Q2.14 */
N    
N    y = (short int)( acc2_32 >> 12);
N    
N    return y;
N}
